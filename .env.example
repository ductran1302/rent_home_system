# Chep thanh .env (da gitignore) truoc khi chay docker compose hoac dev.cmd backend.
# Tao JWT_SECRET moi (64 ky tu):
#   powershell -Command "[guid]::NewGuid().ToString('N')+([guid]::NewGuid().ToString('N'))"
JWT_SECRET=
# Mat khau cho tai khoan admin goc tao luc database moi (chi dung khi chay lan dau).
SEED_ADMIN_PASSWORD=admin123
# Dang ky tai khoan tu cong khai: true chi dung cho moi truong demo,
# dat false cho moi cai dat that (mat dinh la false).
ALLOW_SELF_REGISTER=false
